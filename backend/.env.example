APP_NAME=Marsad
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# In production set:
#   APP_ENV=production
#   APP_DEBUG=false          <- leaving this true leaks stack traces to visitors
#   APP_URL=https://your-domain.tld
# and run `php artisan key:generate` so APP_KEY is filled in.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# In production use LOG_LEVEL=warning to keep logs useful and small.

# Marsad runs on MySQL. Create the database first, e.g.
#   CREATE DATABASE marsad CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marsad
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production, serve over HTTPS and set:
#   SESSION_SECURE_COOKIE=true

# Login uses Sanctum's stateful (cookie) mode when the request origin appears
# in this list. It defaults to the APP_URL host, so it only needs setting if
# the frontend is served from a different domain than the API.
# SANCTUM_STATEFUL_DOMAINS=your-domain.tld

# Origins permitted to call /api/* cross-origin. Defaults to APP_URL, which is
# correct while the frontend is served by this same application.
# CORS_ALLOWED_ORIGINS=https://your-domain.tld

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
